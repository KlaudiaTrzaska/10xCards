---
import Layout from "@/layouts/Layout.astro";
import StudySession from "@/components/study/StudySession";
---

<Layout title="Study Session">
  <div class="bg-cosmic flex min-h-screen flex-col items-center px-4 py-12">
    <div class="w-full max-w-2xl">
      <div class="mb-8 text-center">
        <h1 class="mb-2 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          Study Session
        </h1>
        <p class="text-sm text-blue-100/60">Review your due cards using spaced repetition.</p>
      </div>

      <div class="rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl sm:p-8">
        <StudySession client:load />
      </div>
    </div>
  </div>
</Layout>
